# 复制为 docker.env 后填写；不要将含密码的 docker.env 提交到 Git
#
# 本机 Docker 连「同一台电脑」上的 MySQL：DB_HOST 用 host.docker.internal（见 docker-compose extra_hosts）
# 连局域网其它机器上的库：改为该机的内网 IP
# MySQL 需 bind-address=0.0.0.0（或至少监听宿主机网卡），且用户授权含 Docker 来源（如 'user'@'%' 或网段）
# 前端默认映射宿主机 8080 → 见 docker-compose.yml

PORT=3500
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你自己的密码，懂吗
DB_NAME=xydatabase
