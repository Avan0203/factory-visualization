{
  "name": "front",
  "private": true,
  "version": "1.0.0",
  "description": "工厂可视化系统 - 基于Vue3 + Three.js + ECharts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:serve": "vite build --mode serve",
    "build:docker": "vue-tsc --noEmit && vite build --mode docker",
    "serve": "node ./scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.13.2",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.7",
    "three": "^0.162.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "^0.162.0",
    "@vitejs/plugin-vue": "^5.2.2",
    "backend": "workspace:*",
    "terser": "^5.44.0",
    "typescript": "^5.6.3",
    "vite": "^6.3.0",
    "vue-tsc": "^2.0.28"
  }
}
