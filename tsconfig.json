{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["packages/front/src/**/*.ts", "packages/front/src/**/*.d.ts", "packages/front/src/**/*.tsx", "packages/front/src/**/*.vue","packages/backend/src/**/*.ts", "packages/backend/src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}

